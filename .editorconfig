# https://editorconfig.org : réglages d'écriture communs à tous les éditeurs
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# AutoHotkey et PowerShell : UTF-8 avec BOM (sinon les accents s'affichent mal) et fins de ligne Windows
[*.{ahk,ps1,psd1}]
charset = utf-8-bom
end_of_line = crlf
indent_size = 4

[*.md]
trim_trailing_whitespace = false
