// Relecture des documents Markdown : https://github.com/DavidAnson/markdownlint-cli2
{
  "config": {
    "default": true,
    // Pas de longueur maximale de ligne : les phrases restent entières.
    "MD013": false,
    // Seules balises HTML permises : les touches du clavier.
    "MD033": { "allowed_elements": ["kbd"] }
  },
  "globs": ["**/*.md"],
  "ignores": ["dist/**", "outils/.cache/**", "node_modules/**"]
}
